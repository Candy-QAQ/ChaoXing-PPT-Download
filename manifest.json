{
  "manifest_version": 3,
  "name": "超星课件PDF嗅探下载器",
  "version": "1.0",
  "description": "嗅探超星/学习通网页中的课件数据包，提取PDF下载链接并显示下载按钮。",
  "permissions": [
    "scripting"
  ],
  "host_permissions": [
    "*://*.chaoxing.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected_spy.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["*://*.chaoxing.com/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}